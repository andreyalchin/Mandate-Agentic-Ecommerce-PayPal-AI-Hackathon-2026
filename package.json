{
  "name": "paypal-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-sandbox.ts",
    "smoke:claude": "tsx scripts/smoke-claude.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "build": "npm run web:build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@paypal/paypal-server-sdk": "2.5.0",
    "express": "^5.1.0",
    "undici": "^7.30.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^3.0.0"
  }
}
