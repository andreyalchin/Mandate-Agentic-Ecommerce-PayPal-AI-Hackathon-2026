# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after you add a webhook URL to the sandbox app
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PORT=8787
# Public origin used for vault return/cancel URLs and v6 client-token domains
PUBLIC_ORIGIN=http://localhost:8787
ANTHROPIC_API_KEY=
# Optional: pin a model; otherwise the newest Sonnet available to the key is used
ANTHROPIC_MODEL=
# Mandate signing key (Ed25519 PKCS#8 PEM). If unset, one is generated in DATA_DIR on first run.
MANDATE_SIGNING_KEY=
# Where mandates, receipts and agent keys are snapshotted (use a persistent disk in production)
DATA_DIR=data
# Channel3 live product discovery over MCP. Free tier works without a key; set CHANNEL3=off to disable.
CHANNEL3_API_KEY=
CHANNEL3=
# AG Studio license (the spend console runs with a watermark without one)
AG_STUDIO_LICENSE=
