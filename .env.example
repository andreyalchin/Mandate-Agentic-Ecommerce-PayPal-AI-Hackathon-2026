# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after you add a webhook URL to the sandbox app
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PORT=8787
# Public origin used for vault return/cancel URLs and v6 client-token domains
PUBLIC_ORIGIN=http://localhost:8787
ANTHROPIC_API_KEY=
# Optional: pin a model; otherwise the newest Sonnet available to the key is used
ANTHROPIC_MODEL=
